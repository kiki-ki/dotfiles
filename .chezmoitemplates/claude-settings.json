      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git checkout -b *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git stash *)",
      "Bash(git tag *)",
      "Bash(git remote)",
      "Bash(git remote -v)",
      "Bash(git remote get-url *)",
      "Bash(git remote show *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files*)",
      "Bash(git blame *)",
      "Bash(git shortlog *)",
      "Bash(git config --get *)",
      "Bash(git config --list*)",
      "Bash(git config --show-origin *)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr status*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh search *)",
      "Bash(gh run *)",
      "Bash(gh workflow *)",
      "Bash(gh repo view*)",
      "Bash(gh repo clone*)",
      "Bash(gh auth status*)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(which *)",
      "Bash(pwd)",
      "Bash(date *)",
      "Bash(echo *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)",
      "Bash(diff *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(jq *)",
      "Bash(chezmoi apply *)",
      "Bash(chezmoi diff*)",
      "Bash(chezmoi status*)",
      "Bash(chezmoi managed*)",
      "Bash(chezmoi cat *)",
      "Bash(chezmoi source-path*)",
      "Bash(chezmoi data*)",
      "Bash(chezmoi verify*)",
      "Bash(tr *)",
      "Bash(cut *)",
      "Bash(tee *)",
      "Bash(true)",
      "Bash(test *)",
      "Bash(grep *)",
      "Bash(printf *)",
      "Bash(sleep *)"
    ],
    "ask": [
      "Bash(gh workflow run*)",
      "Bash(gh workflow enable*)",
      "Bash(gh workflow disable*)",
      "Bash(gh run rerun*)",
      "Bash(gh run cancel*)",
      "Bash(gh run delete*)",
      "Bash(gh release create*)",
      "Bash(git push *--tags*)",
      "Bash(git push *--follow-tags*)",
      "Bash(git push *refs/tags/*)",
      "Bash(git push * tag *)",
      "Bash(gh pr merge*)"
    ],
    "deny": [
      "Bash(sh)",
      "Bash(bash)",
      "Bash(zsh)",
      "Bash(sh -s*)",
      "Bash(bash -s*)",
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Bash(git push *--delete*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push -d *)",
      "Bash(git push * -d *)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--prune*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -*f*)",
      "Bash(git branch -D *)",
      "Bash(git branch -df*)",
      "Bash(git branch -fd*)",
      "Bash(git branch -d -f*)",
      "Bash(git branch -f *)",
      "Bash(git branch *--force*)",
      "Bash(git stash drop*)",
      "Bash(git switch -f*)",
      "Bash(git switch * -f*)",
      "Bash(git switch *--force*)",
      "Bash(git switch *--discard-changes*)",
      "Bash(git stash clear*)",
      "Bash(git reflog expire*)",
      "Bash(gh api *actions/*)",
      "Bash(gh api *dispatches*)",
      "Bash(sudo *)",
      "Bash(pkill *)",
      "Bash(killall *)",
      "Bash(chezmoi destroy*)",
      "Bash(chezmoi purge*)",
      "Bash(chown *)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.kube/**)",
      "Edit(~/.gnupg/**)",
      "Edit(//etc/**)",
      "Read(~/.ssh/**/id_*)",
      "Read(~/.aws/credentials)",
      "Read(~/.gnupg/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.py"
  },
  "language": "Japanese",
  "preferredNotifChannel": "ghostty",
  "extraKnownMarketplaces": {
    "kikit": {
      "source": {
        "source": "github",
        "repo": "kiki-ki/kikit"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "kikit@kikit": true,
    "pyright-lsp@claude-plugins-official": true
  }
}
