{{- /* chezmoi:modify-template */ -}}
{{- /* Merge plugin settings from the target so each machine can add its own plugins */ -}}
{{- $settings := includeTemplate "claude-settings.json" . | fromJson -}}
{{- $local := dict -}}
{{- if .chezmoi.stdin -}}
{{-   $local = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- range $key := list "enabledPlugins" "extraKnownMarketplaces" -}}
{{-   if hasKey $local $key -}}
{{-     $_ := set $settings $key (mergeOverwrite (dig $key dict $settings) (get $local $key)) -}}
{{-   end -}}
{{- end -}}
{{- toPrettyJson "  " $settings }}
