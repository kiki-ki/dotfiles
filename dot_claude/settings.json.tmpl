{{- /* Machine-specific plugins come from claudePlugins in the untracked chezmoi.toml so they never reach other machines */ -}}
{{- $settings := includeTemplate "claude-settings.json" . | fromJson -}}
{{- $plugins := get . "claudePlugins" | default list -}}
{{- if not (kindIs "slice" $plugins) -}}
{{-   fail "claudePlugins in chezmoi.toml must be a list of plugin names" -}}
{{- end -}}
{{- range $plugins -}}
{{-   $_ := set $settings.enabledPlugins . true -}}
{{- end -}}
{{- toPrettyJson "  " $settings }}
