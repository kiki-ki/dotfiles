#!/bin/sh
# core.hooksPath takes over hooks for every repository, so run the repository's
# own pre-commit first to preserve its behaviour.
# git rev-parse --git-path hooks cannot be used here: it resolves to
# core.hooksPath itself, which would make this hook call itself recursively.
set -e

repo_hook="$(git rev-parse --git-dir)/hooks/pre-commit"
if [ -x "$repo_hook" ]; then
  "$repo_hook" "$@"
fi

# command -v is not enough: a mise shim exists on PATH even when no version is
# resolved for the current config, and running it then fails.
gitleaks version >/dev/null 2>&1 || exit 0

gitleaks git --staged --no-banner --redact --verbose
