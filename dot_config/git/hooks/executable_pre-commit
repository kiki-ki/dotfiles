#!/bin/sh
# core.hooksPath で全リポジトリのフックを横取りするため、リポジトリ固有の
# .git/hooks/pre-commit があれば先に実行して従来の挙動を保つ。
# なお git rev-parse --git-path hooks は core.hooksPath 自体を返すため使えない。
set -e

repo_hook="$(git rev-parse --git-dir)/hooks/pre-commit"
if [ -x "$repo_hook" ]; then
  "$repo_hook" "$@"
fi

# gitleaks 未導入の環境でコミットを止めない
command -v gitleaks >/dev/null 2>&1 || exit 0

gitleaks git --staged --no-banner --redact --verbose
