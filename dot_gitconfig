[user]
  email = malpie0619@gmail.com
  name = kiki-ki

[core]
  editor = nvim
  ignorecase = false
  pager = delta
  hooksPath = ~/.config/git/hooks

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true

[pull]
  rebase = false

[merge]
  conflictstyle = diff3

[fetch]
  prune = true

[push]
  autoSetupRemote = true

[rebase]
  autostash = true

[rerere]
  enabled = true

[diff]
  algorithm = histogram
  colorMoved = default

[branch]
  sort = -committerdate

[column]
  ui = auto

[commit]
  verbose = true

[include]
  path = ~/.gitconfig_shared

[alias]
  pushf = push --force-with-lease --force-if-includes

